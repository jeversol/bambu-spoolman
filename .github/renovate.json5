{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':enablePreCommit'],
  timezone: 'America/New_York',
  prConcurrentLimit: 5,
  dependencyDashboard: true,
  // Re-test Renovate branches whenever main advances, not just on conflicts.
  rebaseWhen: 'behind-base-branch',
  prCreation: 'immediate',
  // Only timestamp-capable release sources receive the cooldown below.
  // pnpm's own age check remains disabled.
  minimumReleaseAge: null,
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',
  // Dependabot supplies intelligence; Renovate alone creates update PRs.
  // All security fixes bypass cooldowns and schedules, but require human review.
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    labels: ['security'],
    prCreation: 'immediate',
    rangeStrategy: 'update-lockfile',
    vulnerabilityFixStrategy: 'lowest',
    automerge: false,
  },
  // Direct-dependency updates refresh only the packages involved in that
  // update. Refresh every lockfile weekly as a separate, reviewable PR so
  // transitive dependencies do not remain pinned indefinitely.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 4am on monday'],
  },
  // Track shell-script pins alongside the built-in package and image managers.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/security-audit\\.sh$/'],
      matchStrings: [
        'uvx pip-audit==(?<currentValue>[^ ]+)',
      ],
      depNameTemplate: 'pip-audit',
      datasourceTemplate: 'pypi',
    },
  ],
  // Renovate checks release age and CI before merging; GitHub rules still apply.
  automerge: false,
  ignoreTests: false,
  automergeType: 'pr',
  platformAutomerge: false,
  packageRules: [
    {
      description: 'Wait at least one day for timestamped package and tool releases',
      matchDatasources: ['npm', 'pypi', 'github-tags', 'github-releases', 'apk'],
      minimumReleaseAge: '1 day',
    },
    {
      description: 'Do not invent release ages for digest changes or existing pins',
      matchUpdateTypes: ['digest', 'pinDigest', 'pin', 'lockFileMaintenance'],
      minimumReleaseAge: null,
    },
    {
      description: 'Update and validate the Renovate hook once a week',
      matchManagers: ['pre-commit'],
      matchPackageNames: ['renovatebot/pre-commit-hooks'],
      matchUpdateTypes: ['patch', 'minor'],
      groupName: 'renovate validator',
      schedule: ['* 0-4 * * 1'],
      automerge: true,
    },
    {
      description: 'Keep the Python container on the project-supported minor',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.14-alpine3\\.24$/',
    },
    {
      description: 'Exercise only the chosen next Python minor, including prereleases',
      matchManagers: ['dockerfile'],
      matchFileNames: ['.github/docker/Dockerfile.next-python'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.15(?:[.-]|$)/',
      ignoreUnstable: false,
    },
    {
      description: 'Keep the Python project requirement on the supported minor',
      matchManagers: ['pep621'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.14\\./',
    },
    {
      description: 'Keep Ruff and its lockfile on the same approved release',
      matchManagers: ['pep621'],
      matchPackageNames: ['ruff'],
      rangeStrategy: 'pin',
    },
    {
      description: 'Automerge verified production Python base digest updates',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchPackageNames: ['python'],
      matchUpdateTypes: ['digest'],
      automerge: true,
    },
    {
      description: 'Look up Alpine packages in the production base release',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchDatasources: ['apk'],
      registryUrls: [
        'https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64',
      ],
      groupName: 'alpine packages',
    },
    {
      description: 'Keep the Node build toolchain on the supported LTS major',
      matchDatasources: ['apk'],
      matchPackageNames: ['nodejs'],
      allowedVersions: '/^24\\./',
    },
    {
      description: 'Keep Node types aligned with the supported runtime major',
      matchManagers: ['npm'],
      matchPackageNames: ['@types/node'],
      allowedVersions: '<25',
    },
    {
      description: 'Group minor and patch npm updates',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm minor and patch dependencies',
    },
    {
      description: 'Group minor and patch Python updates',
      matchManagers: ['pep621', 'pip_requirements', 'pip_setup', 'poetry', 'uv'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'python minor and patch dependencies',
    },
    {
      description: 'Group minor and patch Docker updates',
      matchManagers: ['dockerfile', 'docker-compose'],
      matchDatasources: ['docker'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'docker minor and patch dependencies',
    },
    {
      description: 'Keep React runtime and type packages aligned',
      matchManagers: ['npm'],
      matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'],
      groupName: 'react packages',
    },
    {
      description: 'Group minor, patch, and digest GitHub Actions updates',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github actions minor and patch dependencies',
    },
  ],
}
