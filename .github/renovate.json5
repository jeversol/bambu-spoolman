{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':enablePreCommit'],
  timezone: 'America/New_York',
  // One routine batch, built overnight on Monday in the existing project timezone.
  schedule: ['* 0-5 * * 1'],
  updateNotScheduled: false,
  prConcurrentLimit: 1,
  dependencyDashboard: true,
  // Respect branch protection without rebuilding every batch on every main push.
  rebaseWhen: 'auto',
  prCreation: 'immediate',
  // Only timestamp-capable release sources receive the cooldown below.
  // pnpm's own age check remains disabled.
  minimumReleaseAge: null,
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',
  // Dependabot supplies intelligence; Renovate alone creates update PRs.
  // Supported security fixes bypass routine gates and require human review.
  // Lockfile-only transitive vulnerabilities may still need a manual fix.
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    schedule: [],
    updateNotScheduled: true,
    dependencyDashboardApproval: false,
    labels: ['security'],
    prCreation: 'immediate',
    rangeStrategy: 'update-lockfile',
    vulnerabilityFixStrategy: 'lowest',
    automerge: false,
  },
  // Renovate cannot combine full lockfile refreshes with dependency updates.
  // The weekly batch updates relevant locks, not the whole transitive graph.
  lockFileMaintenance: {
    enabled: false,
  },
  // Track shell-script pins alongside the built-in package and image managers.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/actions/scan-image/action\\.yaml$/'],
      matchStrings: [
        'TRIVY_VERSION: (?<currentValue>v[^\\s]+)',
      ],
      depNameTemplate: 'aquasecurity/trivy',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/security-audit\\.sh$/'],
      matchStrings: [
        'uvx pip-audit==(?<currentValue>[^ ]+)',
      ],
      depNameTemplate: 'pip-audit',
      datasourceTemplate: 'pypi',
    },
  ],
  // Every batch requires human review and CI, including images and validator pins.
  automerge: false,
  ignoreTests: false,
  automergeType: 'pr',
  platformAutomerge: false,
  packageRules: [
    {
      description: 'Combine routine updates across all managers into one weekly PR',
      matchPackageNames: ['*'],
      groupName: 'weekly maintenance',
      groupSlug: 'weekly-maintenance',
      groupSingleUpdates: true,
      separateMajorMinor: false,
      separateMinorPatch: false,
    },
    {
      description: 'Wait at least seven days for timestamped package and tool releases',
      matchDatasources: ['npm', 'pypi', 'github-tags', 'github-releases', 'apk'],
      minimumReleaseAge: '7 days',
    },
    {
      description: 'Do not invent release ages for digest changes or existing pins',
      matchUpdateTypes: ['digest', 'pinDigest', 'pin', 'lockFileMaintenance'],
      minimumReleaseAge: null,
    },
    {
      description: 'Keep the Python container on the project-supported minor',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.14-alpine3\\.24$/',
    },
    {
      description: 'Exercise only the chosen next Python minor, including prereleases',
      matchManagers: ['dockerfile'],
      matchFileNames: ['.github/docker/Dockerfile.next-python'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.15(?:\\.\\d+(?:(?:a|b|rc)\\d+)?|-rc)?-alpine3\\.24$/',
      ignoreUnstable: false,
      // Compatibility experiments are planned work, outside the routine batch.
      dependencyDashboardApproval: true,
      groupName: null,
      groupSlug: null,
    },
    {
      description: 'Keep the Python project requirement on the supported minor',
      matchManagers: ['pep621'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.14\\./',
    },
    {
      description: 'Keep Ruff and its lockfile on the same approved release',
      matchManagers: ['pep621'],
      matchPackageNames: ['ruff'],
      rangeStrategy: 'pin',
    },
    {
      description: 'Look up Alpine runtime packages in the production base release',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchDatasources: ['apk'],
      registryUrls: [
        'https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64',
      ],
    },
    {
      description: 'Keep the Node build toolchain on the supported LTS major and Debian release',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchPackageNames: ['node'],
      allowedVersions: '/^24-trixie-slim$/',
    },
    {
      description: 'Keep Node types aligned with the supported runtime major',
      matchManagers: ['npm'],
      matchPackageNames: ['@types/node'],
      allowedVersions: '<25',
    },
    {
      description: 'Approve major upgrades and package replacements as planned work',
      matchUpdateTypes: ['major', 'replacement'],
      dependencyDashboardApproval: true,
      groupName: null,
      groupSlug: null,
    },
  ],
}
