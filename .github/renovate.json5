{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':enablePreCommit'],
  timezone: 'America/New_York',
  prConcurrentLimit: 5,
  dependencyDashboard: true,
  rebaseWhen: 'behind-base-branch',
  prCreation: 'immediate',
  // Release age delays automerge, not branch creation or rebasing.
  internalChecksFilter: 'none',
  // Dependabot supplies vulnerability intelligence; Renovate is the sole PR
  // generator. Security fixes bypass normal schedules and release-age delays,
  // but still require the repository's tests and human review.
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['security'],
    prCreation: 'immediate',
    minimumReleaseAge: null,
    rangeStrategy: 'update-lockfile',
    vulnerabilityFixStrategy: 'lowest',
    automerge: false,
  },
  // Direct-dependency updates refresh only the packages involved in that
  // update. Refresh every lockfile weekly as a separate, reviewable PR so
  // transitive dependencies do not remain pinned indefinitely.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 4am on monday'],
  },
  // Track shell-script pins alongside the built-in package and image managers.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/security-audit\\.sh$/'],
      matchStrings: [
        'uvx pip-audit==(?<currentValue>[^ ]+)',
      ],
      depNameTemplate: 'pip-audit',
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^scripts/security-audit\\.sh$/'],
      matchStrings: [
        'node:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'node',
      datasourceTemplate: 'docker',
    },
  ],
  // Renovate checks release age and CI before merging; GitHub rules still apply.
  automergeType: 'pr',
  platformAutomerge: false,
  packageRules: [
    {
      description: 'Update the Renovate pre-commit hook once a week',
      matchPackageNames: ['renovatebot/pre-commit-hooks'],
      matchUpdateTypes: ['patch', 'minor'],
      schedule: ['* 0-4 * * 1'],
      automerge: true,
    },
    {
      description: 'Automerge stable non-major updates after CI passes',
      matchCurrentVersion: '!/^0/',
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Keep the Python container on the project-supported minor',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.14-alpine$/',
    },
    {
      description: 'Keep the Python project requirement on the supported minor',
      matchManagers: ['pep621'],
      matchPackageNames: ['python'],
      allowedVersions: '/^3\\.14\\./',
    },
    {
      description: 'Keep Ruff and its lockfile on the same approved release',
      matchManagers: ['pep621'],
      matchPackageNames: ['ruff'],
      rangeStrategy: 'pin',
    },
    {
      description: 'Automerge production Python image rebuilds after CI',
      matchManagers: ['dockerfile'],
      matchFileNames: ['Dockerfile'],
      matchPackageNames: ['python'],
      matchUpdateTypes: ['digest'],
      automerge: true,
    },
    {
      description: 'Keep Node containers on the supported LTS major',
      matchDatasources: ['docker'],
      matchPackageNames: ['node'],
      allowedVersions: '/^24-alpine$/',
    },
    {
      description: 'Apply release-age cooldown to major updates',
      matchUpdateTypes: ['major'],
      minimumReleaseAge: '14 days',
    },
    {
      description: 'Wait before automerging minor updates',
      matchUpdateTypes: ['minor'],
      minimumReleaseAge: '7 days',
    },
    {
      description: 'Wait before automerging patch updates',
      matchUpdateTypes: ['patch'],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Group minor and patch npm updates',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm minor and patch dependencies',
    },
    {
      description: 'Group minor and patch Python updates',
      matchManagers: ['pep621', 'pip_requirements', 'pip_setup', 'poetry', 'uv'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'python minor and patch dependencies',
    },
    {
      description: 'Group minor and patch Docker updates',
      matchManagers: ['dockerfile', 'docker-compose'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'docker minor and patch dependencies',
    },
    {
      description: 'Keep Next.js and its ESLint configuration aligned',
      matchManagers: ['npm'],
      matchPackageNames: ['next', 'eslint-config-next'],
      groupName: 'next.js packages',
    },
    {
      description: 'Keep React runtime and type packages aligned',
      matchManagers: ['npm'],
      matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'],
      groupName: 'react packages',
    },
    {
      description: 'Group minor, patch, and digest GitHub Actions updates',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github actions minor and patch dependencies',
    },
  ],
}
