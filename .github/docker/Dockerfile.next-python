# This image is an early-warning compatibility test, not a production build.
# Production continues to use the version-and-digest-pinned base in /Dockerfile.
ARG NEXT_PYTHON_IMAGE=python:3.15-alpine3.24

FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

FROM ${NEXT_PYTHON_IMAGE} AS next_python_verifier

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY . .

# The production metadata and lock deliberately support one Python minor. For
# this disposable test only, widen the metadata and resolve a fresh environment
# so incompatible packages or missing wheels are detected before promotion.
RUN sed -i 's/^requires-python = .*/requires-python = ">=3.14,<4"/' pyproject.toml \
    && rm uv.lock \
    && uv sync \
    && .venv/bin/python -m unittest discover -s tests \
    && .venv/bin/ruff check . \
    && .venv/bin/ruff format --check .
